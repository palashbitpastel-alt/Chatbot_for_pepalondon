# Copy to .env and fill in real values
PROJECT_NAME=Upselling Product API
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite+aiosqlite:///./upselling.db
CORS_ORIGINS=["http://localhost:3000"]

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_STORE_URL=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

# Embeddings for the admin agent's RAG memory (pgvector on Postgres).
# Leave EMBEDDING_API_KEY empty to use the built-in local embedder.
EMBEDDING_PROVIDER=auto
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536



# ── Who the widget may say it is ───────────────────────────────────────────
# The storefront widget posts a customer block (logged_in, id, email). Turning
# this on lets the agent act on it: "show my orders", "suggest something based
# on what I bought" work without an order number.
#
# READ THIS BEFORE ENABLING IN PRODUCTION. That block is sent by the browser, so
# this endpoint believes whoever posts to it. Anyone who can reach the API can
# send {"customer": {"logged_in": true, "email": "someone@else.com"}} and read
# that person's entire order history. The "verified" flag does not help - it
# comes from the same payload, so a caller can set it just as easily.
#
# The safe way to keep this on is to make the request itself authenticated, so
# the email never has to be taken on trust: serve the widget through a Shopify
# App Proxy and check the HMAC signature, then pass the verified address to
# shopper_identity.resolve(trusted_email=...), which already accepts it and
# overrides the browser claim. Off is the safe default for a public endpoint.
TRUST_STOREFRONT_CUSTOMER=false

# ── Order self-service ─────────────────────────────────────────────────────
# Lets a shopper cancel an order or move its delivery address from the chat.
# Needs the `write_orders` Admin scope. Turn off to remove both tools.
SUPPORT_ORDER_CHANGES=true
# Before either write, the shopper must confirm the postcode already on the
# order. Leave this on unless the request itself is authenticated: an order
# number and an email are both guessable, and together they are a weak secret.
SUPPORT_VERIFY_ORDER_CHANGES=true
SUPPORT_CHANGE_TTL_MINUTES=15
SUPPORT_CHANGE_MAX_ATTEMPTS=3
# Past this many days a cancellation is really a return, and a human takes it.
SUPPORT_CANCEL_WINDOW_DAYS=14

# ── Categories ─────────────────────────────────────────────────────────────
# GET /support/categories groups the live catalogue by product type and hands
# back a tile for each - id, name, image, count, price from. Cached; the
# catalogue barely moves.
SUPPORT_CATEGORY_CACHE_MINUTES=30

# ── Opening screen ─────────────────────────────────────────────────────────
# POST /support/chat with {"message": ""} is the widget saying a shopper just
# opened it. It answers with a greeting and a row of collections to tap, saves
# nothing to the thread, and never spends an agent turn.
# Blank greets with the store's own name ("Welcome to LittleNest ...").
SUPPORT_WELCOME_MESSAGE=
# Exact collections to show, by handle, in this order. Leave empty to pick the
# fullest ones automatically - worth setting, or an old collection left on the
# store can surface next to the ones you meant.
# SUPPORT_WELCOME_COLLECTIONS=premium-edition,trending-now,spring-bloom,winter-luxe
SUPPORT_WELCOME_COLLECTIONS=
SUPPORT_WELCOME_COLLECTION_LIMIT=8
SUPPORT_WELCOME_CACHE_MINUTES=30

# ── Best sellers ───────────────────────────────────────────────────────────
# The agent ranks products by what has actually been ordered, because Shopify's
# Admin API has no best-selling sort. Needs the `read_orders` scope, which the
# order lookup already uses. The scan is capped and the answer cached, so one
# chat can never walk the whole order history.
SUPPORT_BEST_SELLER_DAYS=365
SUPPORT_BEST_SELLER_ORDER_PAGES=8
SUPPORT_BEST_SELLER_CACHE_MINUTES=15
# Orders paid through Shopify's test gateway. Set this to false on a live store
# so play money never shapes what shoppers are shown; leave it on for a demo or
# dev store, where test orders are the only sales there are.
SUPPORT_BEST_SELLERS_COUNT_TEST_ORDERS=true

# ── Who may call this from a browser ───────────────────────────────────────
# A blocked origin fails before the widget sees a reply, so it shows up as
# "I could not reach our support system", not as a CORS error. Every dev store
# is a new origin, so myshopify hosts are matched by pattern; put custom
# domains (your live shop) in CORS_ORIGINS.
# CORS_ORIGINS=["https://littlenest.com","http://localhost:3000"]
# CORS_ORIGIN_REGEX=https://[a-z0-9][a-z0-9-]*\.myshopify\.com
